@page
@model BarberHub.Web.Pages.Painel.BarbeirosModel
@{ ViewData["Title"] = "Barbeiros"; }

<div class="bh-secao-titulo">
    <div>
        <h2>Barbeiros</h2>
        <p>
            Plano @Model.Plano.Nome: @Model.Barbeiros.Count de @Model.Plano.LimiteBarbeiros em uso.
            @if (Model.Barbeiros.Count >= Model.Plano.LimiteBarbeiros && Model.Plano.Plano == Plano.Basico)
            {
                <a asp-page="/Painel/Assinatura">Mude para o Pro para ter até 5.</a>
            }
        </p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="bh-card">
            <h5 class="mb-3">Adicionar barbeiro</h5>
            <form method="post" asp-page-handler="Criar">
                <label class="form-label" for="nome">Nome</label>
                <input id="nome" name="nome" class="form-control mb-3" required />
                <button class="btn btn-bh w-100">Adicionar barbeiro</button>
            </form>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="bh-card">
            <h5 class="mb-1">Equipe</h5>
            @if (Model.Barbeiros.Count == 0)
            {
                <p class="text-muted mb-0">Nenhum barbeiro ainda. Adicione pelo menos um para os clientes conseguirem agendar.</p>
            }
            @foreach (var b in Model.Barbeiros)
            {
                <form method="post" asp-page-handler="Inativar" class="bh-lista-item">
                    <input type="hidden" name="id" value="@b.Id" />
                    <span class="bh-letreiro fs-4">@b.Nome</span>
                    <button class="btn btn-sm btn-perigo" onclick="return confirm('Remover @b.Nome?')">Remover</button>
                </form>
            }
        </div>
    </div>
</div>
