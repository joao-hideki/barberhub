@page
@model BarberHub.Web.Pages.Painel.AssinaturaModel
@{
    ViewData["Title"] = "Assinatura";
    var b = Model.Barbearia;
    var ativa = b.AssinaturaAtiva(Model.Hoje);
}

<div class="bh-secao-titulo">
    <div>
        <h2>Assinatura</h2>
        <p>
            Plano atual: <strong>@Planos.Info(b.Plano).Nome</strong>,
            @if (!ativa) { <span class="text-danger fw-bold">vencido em @b.AssinaturaValidaAte.ToString("dd/MM/yyyy")</span> }
            else if (b.EmPeriodoGratis) { <span>período grátis até <strong>@b.AssinaturaValidaAte.ToString("dd/MM/yyyy")</strong></span> }
            else { <span>ativo até <strong>@b.AssinaturaValidaAte.ToString("dd/MM/yyyy")</strong></span> }.
        </p>
    </div>
</div>

<form method="post">
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="bh-card h-100">
                <h5 class="mb-3">Plano</h5>
                @foreach (var p in Planos.Todos)
                {
                    <label class="bh-opcao-plano" for="plano-@p.Plano">
                        <div>
                            <input type="radio" class="form-check-input me-2" asp-for="Plano" value="@p.Plano" id="plano-@p.Plano" />
                            <strong>@p.Nome</strong>
                            <span>, @(p.LimiteBarbeiros == 1 ? "1 barbeiro" : $"até {p.LimiteBarbeiros} barbeiros")</span>
                        </div>
                        <strong>@Formulario.Moeda(p.PrecoMensal)/mês</strong>
                    </label>
                }
                <p class="small text-muted mt-3 mb-0">
                    Pagar durante o período grátis não faz perder os dias restantes: o mês pago começa depois deles.
                </p>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="bh-card h-100">
                <h5 class="mb-3">Cartão de crédito</h5>
                <div class="mb-3"><label class="form-label" for="NumeroCartao">Número do cartão</label><input class="form-control" asp-for="NumeroCartao" inputmode="numeric" autocomplete="cc-number" placeholder="4111 1111 1111 1111" required /></div>
                <div class="mb-3"><label class="form-label" for="NomeTitular">Nome impresso no cartão</label><input class="form-control" asp-for="NomeTitular" autocomplete="cc-name" required /></div>
                <div class="row g-2 mb-4">
                    <div class="col"><label class="form-label" for="Validade">Validade</label><input class="form-control" asp-for="Validade" autocomplete="cc-exp" placeholder="MM/AA" required /></div>
                    <div class="col"><label class="form-label" for="Cvv">CVV</label><input class="form-control" asp-for="Cvv" inputmode="numeric" autocomplete="cc-csc" placeholder="123" required /></div>
                </div>
                <button class="btn btn-bh btn-lg w-100">Pagar e ativar plano</button>
                <p class="bh-cartao-aviso mb-0">
                    Pagamento simulado, nenhuma cobrança real é feita. Use <code>4111 1111 1111 1111</code> para aprovar
                    ou um número terminado em <code>0000</code> para recusar.
                </p>
            </div>
        </div>
    </div>
</form>

@if (Model.Historico.Count > 0)
{
    <div class="bh-card mt-4">
        <h5 class="mb-1">Histórico de pagamentos</h5>
        <div class="table-responsive">
            <table class="table">
                <thead><tr><th>Data</th><th>Plano</th><th>Valor</th><th>Resultado</th><th>Transação</th></tr></thead>
                <tbody>
                    @foreach (var p in Model.Historico)
                    {
                        <tr>
                            <td>@p.Data.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@Planos.Info(p.Plano).Nome</td>
                            <td>@Formulario.Moeda(p.Valor)</td>
                            <td><span class="badge-status @(p.Aprovado ? "status-Confirmado" : "status-Cancelado")">@p.Mensagem</span></td>
                            <td><small class="text-muted">@p.TransacaoId</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
