@page
@model BarberHub.Web.Pages.Painel.IndexModel
@{
    ViewData["Title"] = "Painel";
    var ativa = Model.Barbearia.AssinaturaAtiva(Model.Hoje);
    var emAberto = Model.AgendaDeHoje.Count(a => a.Status is StatusAgendamento.Agendado or StatusAgendamento.Confirmado);
}

<div class="bh-secao-titulo">
    <div>
        <h2>@Model.Barbearia.Nome</h2>
        <p>@Formulario.DiaPorExtenso(Model.Hoje)</p>
    </div>
    <a asp-page="/Painel/Agenda" class="btn btn-verde">Abrir agenda de hoje</a>
</div>

@if (!ativa)
{
    <div class="alert alert-danger">
        Sua assinatura venceu em @Model.Barbearia.AssinaturaValidaAte.ToString("dd/MM/yyyy") e a página de agendamento está bloqueada.
        <a asp-page="/Painel/Assinatura" class="alert-link">Renovar agora</a>.
    </div>
}

<div class="bh-indicadores">
    <div class="bh-indicador">
        <div class="bh-indicador-rotulo">Em aberto hoje</div>
        <div class="bh-indicador-valor">@emAberto</div>
    </div>
    <div class="bh-indicador">
        <div class="bh-indicador-rotulo">Concluídos no mês</div>
        <div class="bh-indicador-valor">@Model.Resumo.AtendimentosConcluidos</div>
    </div>
    <div class="bh-indicador">
        <div class="bh-indicador-rotulo">Faturamento do mês</div>
        <div class="bh-indicador-valor">@Formulario.Moeda(Model.Resumo.Faturamento)</div>
    </div>
    <div class="bh-indicador">
        <div class="bh-indicador-rotulo">Plano @Planos.Info(Model.Barbearia.Plano).Nome</div>
        <div class="bh-indicador-valor pequeno">
            @if (!ativa) { <span class="text-danger">Vencido</span> }
            else if (Model.Barbearia.EmPeriodoGratis) { <span>Grátis até @Model.Barbearia.AssinaturaValidaAte.ToString("dd/MM")</span> }
            else { <span>Ativo até @Model.Barbearia.AssinaturaValidaAte.ToString("dd/MM")</span> }
        </div>
        <a asp-page="/Painel/Assinatura" class="small">Gerenciar assinatura</a>
    </div>
</div>

<div class="bh-link-publico">
    <div>
        <div class="fw-semibold">Link de agendamento dos seus clientes</div>
        <code id="link">@Model.LinkPublico</code>
        <div class="small text-muted">Coloque na bio do Instagram, no Google e no status do WhatsApp.</div>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-bh" type="button" onclick="navigator.clipboard.writeText(document.getElementById('link').textContent.trim()); this.textContent='Link copiado'">Copiar link</button>
        <a class="btn btn-linha" href="@Model.LinkPublico" target="_blank" rel="noopener">Abrir</a>
    </div>
</div>

<div class="bh-card">
    <h2 class="h3 mb-2" style="font-size:1.9rem">Hoje</h2>
    @if (Model.AgendaDeHoje.Count == 0)
    {
        <p class="text-muted mb-0">Nenhum atendimento marcado para hoje. Compartilhe o link acima para receber agendamentos.</p>
    }
    else
    {
        <ul class="bh-agenda">
            @foreach (var a in Model.AgendaDeHoje)
            {
                <li class="bh-agenda__item bh-agenda__item--resumo @(a.Status == StatusAgendamento.Cancelado ? "cancelado" : "")">
                    <div class="bh-hora">@a.Inicio.ToString("HH:mm")</div>
                    <div class="bh-agenda__cliente"><span class="fw-semibold">@a.Cliente.Nome</span></div>
                    <div class="bh-agenda__servico">@a.Servico.Nome com @a.Barbeiro.Nome</div>
                    <div class="bh-agenda__status"><span class="badge-status status-@a.Status">@a.Status.Rotulo()</span></div>
                </li>
            }
        </ul>
    }
</div>
