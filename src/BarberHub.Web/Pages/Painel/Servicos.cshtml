@page
@model BarberHub.Web.Pages.Painel.ServicosModel
@{
    ViewData["Title"] = "Serviços";
    int[] duracoes = [15, 30, 45, 60, 75, 90, 120];
}

<div class="bh-secao-titulo">
    <div>
        <h2>Serviços</h2>
        <p>O preço entra no faturamento. A duração define quanto tempo o horário fica bloqueado na agenda do barbeiro.</p>
    </div>
</div>

<div class="bh-card mb-4">
    <h5 class="mb-3">Adicionar serviço</h5>
    <form method="post" asp-page-handler="Criar" class="row g-2 align-items-end">
        <div class="col-md-5"><label class="form-label" for="novo-nome">Nome</label><input id="novo-nome" name="nome" class="form-control" placeholder="Ex.: Corte degradê" required /></div>
        <div class="col-6 col-md-2"><label class="form-label" for="novo-preco">Preço (R$)</label><input id="novo-preco" name="preco" class="form-control" inputmode="decimal" placeholder="40,00" required /></div>
        <div class="col-6 col-md-2">
            <label class="form-label" for="novo-duracao">Duração</label>
            <select id="novo-duracao" name="duracao" class="form-select">
                @foreach (var d in duracoes) { <option value="@d" selected="@(d == 30)">@d min</option> }
            </select>
        </div>
        <div class="col-md-3"><button class="btn btn-bh w-100">Adicionar serviço</button></div>
    </form>
</div>

<div class="bh-card">
    <h5 class="mb-1">Catálogo</h5>
    @if (Model.Servicos.Count == 0)
    {
        <p class="text-muted mb-0">Nenhum serviço ainda. Adicione o primeiro acima para liberar o agendamento.</p>
    }
    @foreach (var s in Model.Servicos)
    {
        <form method="post" class="row g-2 align-items-center py-3 border-bottom">
            <input type="hidden" name="id" value="@s.Id" />
            <div class="col-md-5"><input name="nome" value="@s.Nome" class="form-control fw-semibold" aria-label="Nome do serviço" /></div>
            <div class="col-6 col-md-2"><input name="preco" value="@s.Preco.ToString("0.00")" class="form-control" inputmode="decimal" aria-label="Preço" /></div>
            <div class="col-6 col-md-2">
                <select name="duracao" class="form-select" aria-label="Duração">
                    @foreach (var d in duracoes.Union([s.DuracaoMinutos]).Order()) { <option value="@d" selected="@(d == s.DuracaoMinutos)">@d min</option> }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2 justify-content-end">
                <button class="btn btn-linha" asp-page-handler="Salvar">Salvar</button>
                <button class="btn btn-perigo" asp-page-handler="Inativar" onclick="return confirm('Remover este serviço do catálogo?')">Remover</button>
            </div>
        </form>
    }
</div>
