<!DOCTYPE html>
<html lang="pt-BR">
@{
    var paginaAtual = ViewContext.RouteData.Values["page"] as string;
    string? Atual(string pagina) => paginaAtual == pagina ? "page" : null;
    var logado = User.Identity?.IsAuthenticated == true;
    var noPainel = logado && paginaAtual?.StartsWith("/Painel") == true;
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · BarberHub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500;600&family=Figtree:wght@400;500&family=DM+Mono:wght@400&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (noPainel)
    {
        <div class="bh-app">
            <aside class="bh-lateral">
                <a class="bh-marca" asp-page="/Painel/Index"><span class="bh-poste-mini" aria-hidden="true"></span><span class="bh-marca-nome">BarberHub</span></a>
                <ul class="bh-menu">
                    <li><a asp-page="/Painel/Index" aria-current="@Atual("/Painel/Index")">Painel</a></li>
                    <li><a asp-page="/Painel/Agenda" aria-current="@Atual("/Painel/Agenda")">Agenda</a></li>
                    <li><a asp-page="/Painel/Servicos" aria-current="@Atual("/Painel/Servicos")">Serviços</a></li>
                    <li><a asp-page="/Painel/Barbeiros" aria-current="@Atual("/Painel/Barbeiros")">Barbeiros</a></li>
                    <li><a asp-page="/Painel/Expediente" aria-current="@Atual("/Painel/Expediente")">Expediente</a></li>
                    <li><a asp-page="/Painel/Assinatura" aria-current="@Atual("/Painel/Assinatura")">Assinatura</a></li>
                </ul>
                <form method="post" asp-page="/Sair" class="bh-usuario">
                    <div title="@User.Identity!.Name">@User.Identity!.Name</div>
                    <button class="btn btn-sm btn-linha">Sair</button>
                </form>
            </aside>
            <main class="bh-conteudo">
                <partial name="_Avisos" />
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <header class="bh-topo">
            <div class="container">
                <a class="bh-marca" asp-page="/Index"><span class="bh-poste-mini" aria-hidden="true"></span><span class="bh-marca-nome">BarberHub</span></a>
                <nav>
                    @if (logado)
                    {
                        <a class="btn btn-verde btn-sm" asp-page="/Painel/Index">Ir para o painel</a>
                    }
                    else
                    {
                        <a asp-page="/Entrar">Entrar</a>
                        <a class="btn btn-bh btn-sm" asp-page="/Cadastro">Testar grátis</a>
                    }
                </nav>
            </div>
        </header>

        <main class="container py-4">
            <partial name="_Avisos" />
            @RenderBody()
        </main>

        <footer class="bh-rodape">
            <div class="container">BarberHub, agendamento online para barbearias. MVP acadêmico da FATEC.</div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
