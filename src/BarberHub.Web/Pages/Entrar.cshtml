@page
@model EntrarModel
@{ ViewData["Title"] = "Entrar"; }

<div class="bh-acesso">
    <h1>Entrar</h1>
    <p>Acesse a agenda e o painel da sua barbearia.</p>
    <div class="bh-card">
        @if (Model.Erro is not null)
        {
            <div class="alert alert-danger">@Model.Erro</div>
        }
        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label class="form-label" for="Email">E-mail</label>
                <input class="form-control" asp-for="Email" type="email" autocomplete="email" required />
            </div>
            <div class="mb-4">
                <label class="form-label" for="Senha">Senha</label>
                <input class="form-control" asp-for="Senha" type="password" autocomplete="current-password" required />
            </div>
            <button class="btn btn-verde btn-lg w-100">Entrar</button>
        </form>
    </div>
    <div class="bh-demo">
        <strong>Demonstração</strong>
        <span><code>@BarberHub.Web.Data.DadosIniciais.EmailDemo</code></span>
        <span><code>@BarberHub.Web.Data.DadosIniciais.SenhaDemo</code></span>
    </div>
    <p class="text-center mt-3">Ainda não tem conta? <a asp-page="/Cadastro">Testar grátis</a></p>
</div>
